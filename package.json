{
  "name": "Kupo",
  "private": true,
  "version": "1.1.5",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "bestiary:generate": "node scripts/generate-bestiary.mjs",
    "quests:fetch": "node scripts/fetch-quests.mjs",
    "data:audit": "node scripts/audit-data.mjs",
    "recipes:check": "node scripts/convert-recipes.cjs --check",
    "recipes:update": "node scripts/convert-recipes.cjs",
    "test:skillup": "node --test scripts/skillup.test.mjs",
    "test:data": "node --test scripts/recipes.test.mjs scripts/skillup.test.mjs scripts/item-info.test.mjs scripts/alzadaal.test.mjs scripts/npcs.test.mjs scripts/navigation.test.mjs scripts/printing.test.mjs scripts/prices.test.mjs scripts/digging.test.mjs scripts/raising.test.mjs scripts/gardening.test.mjs scripts/weather.test.mjs scripts/clamming.test.mjs scripts/phoenix.test.mjs scripts/helm.test.mjs scripts/transport.test.mjs scripts/guild-selling.test.mjs",
    "test:guilds": "node --test scripts/guild-selling.test.mjs",
    "gardening:generate": "node scripts/generate-gardening.mjs",
    "test:gardening": "node --test scripts/gardening.test.mjs",
    "raising:generate": "node scripts/generate-raising.mjs",
    "test:raising": "node --test scripts/raising.test.mjs",
    "test:helm": "node --test scripts/helm.test.mjs",
    "helm:maps": "node scripts/fetch-helm-maps.mjs",
    "phoenix:generate": "node scripts/generate-phoenix.mjs",
    "source:generate": "node scripts/generate-phoenix.mjs",
    "weather:generate": "node scripts/generate-weather.mjs",
    "test:weather": "node --test scripts/weather.test.mjs",
    "test:transport": "node --test scripts/transport.test.mjs",
    "test:phoenix": "node --test scripts/phoenix.test.mjs scripts/digging.test.mjs scripts/weather.test.mjs scripts/clamming.test.mjs scripts/helm.test.mjs",
    "test:source": "node --test scripts/phoenix.test.mjs scripts/digging.test.mjs scripts/weather.test.mjs scripts/clamming.test.mjs scripts/helm.test.mjs",
    "test:prices": "node --test scripts/prices.test.mjs",
    "test:printing": "node --test scripts/printing.test.mjs",
    "npcs:generate": "node scripts/generate-npcs.mjs",
    "npcs:fetch": "node scripts/fetch-npcs.mjs",
    "test:npcs": "node --test scripts/npcs.test.mjs scripts/navigation.test.mjs",
    "test:routes": "node --test scripts/alzadaal.test.mjs",
    "items:generate": "node scripts/generate-item-info.mjs",
    "items:fetch": "node scripts/fetch-item-info.mjs",
    "test:items": "node --test scripts/item-info.test.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "node scripts/dist-linux.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.41.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fengari": "^0.1.5",
    "globals": "^17.13.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "typescript": "^5.2.2",
    "vite": "^6.4.4",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.7",
    "wtf_wikipedia": "^10.4.2",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.0"
  },
  "build": {
    "appId": "com.jrbellottie.kupo",
    "productName": "Kupo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "overrides": {
    "@electron/rebuild": "^4.2.1",
    "@electron/asar": "^4.3.1",
    "@electron/get": "^5.1.0",
    "temp": {
      "rimraf": "^5.0.10"
    },
    "glob": "^13.0.6"
  }
}
